# Copy this template to .env and set your own API key locally.
TOUR_API_KEY=

# Optional settings. Paths are relative to the backend process working directory.
PORT=8080
KAKAO_PHOTOS_ENABLED=true
KAKAO_PHOTOS_CACHE_FILE=./data/kakao-photos.json
KAKAO_PHOTOS_MIN_INTERVAL_MS=1100
COMMUNITY_STORE=./data/community.json
